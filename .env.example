# Micro-Agent Environment Variables
# Copy to .env and configure for your environment.
# The library-level resolve_config() utility reads these variables. The current
# `python -m micro_agent` bootstrap does not call that utility or wire these
# values into providers yet. See docs/CONFIGURATION.md and TODO.md P0.3.

# Model configuration
MICRO_AGENT_MODEL_ENDPOINT=
MICRO_AGENT_MODEL_API_KEY=
MICRO_AGENT_MODEL_PROVIDER=

# Memory and session
MICRO_AGENT_MEMORY_ENDPOINT=
MICRO_AGENT_SESSION_ENDPOINT=

# Logging
MICRO_AGENT_LOG_LEVEL=INFO

# Secret references in a definition (environment model_api_key_ref /
# security.credential_refs) are resolved from the environment variable
# named by the reference, e.g. MICRO_AGENT_MODEL_API_KEY above.
